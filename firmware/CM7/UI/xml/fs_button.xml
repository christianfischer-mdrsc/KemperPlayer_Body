<!--
  fs_button.xml
  Wiederverwendbare Komponente: ein Footswitch-Feld in der unteren Leiste.
  Verwendung:  <fs_button fs="FS1" label="Clean Twin" sub="Slot 1"/>
-->
<component>
  <api>
    <prop name="fs"     type="string" default="FS1"/>
    <prop name="label"  type="string" default="Slot"/>
    <prop name="sub"    type="string" default=""/>
    <prop name="bg"     type="color"  default="#tile"/>
    <prop name="border" type="color"  default="#line"/>
  </api>

  <styles>
    <style name="main"
           radius="8"
           border_width="1"
           pad_left="12" pad_right="10" pad_top="8" pad_bottom="8"
           pad_row="2"/>
  </styles>

  <view extends="lv_button"
        width="1" flex_grow="1" height="74"
        flex_flow="column"
        style_bg_color="$bg"
        style_border_color="$border"
        style_shadow_width="0">
    <style name="main"/>

    <lv_label text="$fs"
              style_text_color="#text3"
              style_text_font="lv_font_montserrat_14"/>
    <lv_label text="$label" width="100%" height="24" long_mode="dots"
              style_text_color="#text"
              style_text_font="lv_font_montserrat_20"/>
    <lv_label text="$sub"
              style_text_color="#text3"
              style_text_font="lv_font_montserrat_14"/>
  </view>
</component>
