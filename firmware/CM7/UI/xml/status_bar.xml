<!--
  status_bar.xml
  Statusleiste oben (volle Breite, 40 px): USB-Verbindung links,
  Datum und Uhrzeit rechts. In C: ui_statusbar.c, dort laufen auch
  Uhrzeit und USB-Status mit. Hier nur die Darstellung.
  Verwendung:  <status_bar usb_text="Kemper verbunden" date="Di, 29.09.2026" time="12:43"/>
-->
<component>
  <api>
    <prop name="usb_text"  type="string" default="Kein Kemper"/>
    <prop name="usb_color" type="color"  default="0x6a6e74"/>
    <prop name="date"      type="string" default=""/>
    <prop name="time"      type="string" default="--:--"/>
  </api>

  <view width="100%" height="40" scrollable="false" clickable="false"
        flex_flow="row"
        style_flex_cross_place="center" style_flex_track_place="center"
        style_bg_color="#bar_bg" style_radius="0"
        style_border_side="bottom" style_border_color="#line" style_border_width="1"
        style_pad_hor="16" style_pad_ver="0" style_pad_column="8">
    <lv_label text="&#xF287;"
              style_text_color="$usb_color"
              style_text_font="lv_font_montserrat_22"/>
    <lv_label text="$usb_text"
              style_text_color="#text"
              style_text_font="lv_font_montserrat_16"/>

    <!-- Abstandhalter -->
    <lv_obj height="1" width="1" flex_grow="1"
            style_bg_opa="0" style_border_width="0"/>

    <lv_label text="$date"
              style_text_color="#text2"
              style_text_font="lv_font_montserrat_16"/>
    <lv_obj width="1" height="20" style_bg_color="#line" style_border_width="0"
            style_radius="0" style_margin_left="6" style_margin_right="6"/>
    <lv_label text="$time"
              style_text_color="#text"
              style_text_font="lv_font_montserrat_22"/>
  </view>
</component>
