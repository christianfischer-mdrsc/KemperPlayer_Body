<!--
  edit_screen.xml
  Bearbeiten-Ansicht des Kemper-Displays, 1024 x 600.
  Nur Darstellung, keine Funktion. Nutzt status_bar, section_button, edit_tile,
  fs_button und die Farben aus globals.xml.
  Symbole: LVGL-Symbole aus der Montserrat-Schrift als Platzhalter.
-->
<screen>
  <view width="1024" height="600" scrollable="false"
        flex_flow="column"
        style_bg_color="#bg"
        style_pad_all="0"
        style_pad_row="0">

    <!-- Statusleiste: USB, Datum, Uhrzeit (Werte setzt ui_statusbar.c) -->
    <status_bar usb_text="Kemper verbunden" usb_color="#usb_on"
                date="Di, 29.09.2026" time="12:43"/>

    <!-- Inhaltsbereich unter der Statusleiste -->
    <lv_obj width="100%" height="1" flex_grow="1" scrollable="false"
            flex_flow="column"
            style_bg_opa="0" style_border_width="0" style_radius="0"
            style_pad_all="8" style_pad_row="6">

      <!-- Kopfzeile: Performance links, Bereichs-Buttons rechts -->
      <lv_obj width="100%" height="content" scrollable="false"
              flex_flow="row"
              style_flex_cross_place="center" style_flex_track_place="center"
              style_bg_opa="0" style_border_width="0" style_pad_all="0"
              style_pad_column="6">

        <lv_obj width="content" height="content" scrollable="false"
                style_bg_color="0x16345a" style_border_width="0"
                style_radius="4" style_pad_hor="8" style_pad_ver="4">
          <lv_label text="PERFORMANCE"
                    style_text_color="0xa6cbfa"
                    style_text_font="lv_font_montserrat_12"/>
        </lv_obj>
        <lv_label text="012"
                  style_text_color="#text"
                  style_text_font="lv_font_montserrat_22"/>
        <lv_label text="Sunday Set" width="110" long_mode="dots"
                  style_text_color="#text2"
                  style_text_font="lv_font_montserrat_18"/>

        <!-- Bank-Uebersicht und zurueck zur Live-Ansicht -->
        <lv_button width="44" height="40"
                   style_bg_color="#tile" style_border_color="#line" style_border_width="1"
                   style_radius="8" style_shadow_width="0">
          <lv_label text="&#xF07B;" align="center"
                    style_text_color="0xd6d9de" style_text_font="lv_font_montserrat_18"/>
        </lv_button>
        <lv_button width="44" height="40"
                   style_bg_color="#sel_bg" style_border_color="#sel_line" style_border_width="1"
                   style_radius="8" style_shadow_width="0">
          <lv_label text="&#xF04B;" align="center"
                    style_text_color="0xffffff" style_text_font="lv_font_montserrat_18"/>
        </lv_button>

        <lv_obj height="1" width="1" flex_grow="1"
                style_bg_opa="0" style_border_width="0"/>

        <section_button icon="&#xF00B;" label="RIG"/>
        <section_button icon="&#xF019;" label="INPUT"/>
        <section_button icon="&#xF001;" label="AMP"/>
        <section_button icon="&#xF0C9;" label="EQ"/>
        <section_button icon="&#xF028;" label="CAB"/>
        <section_button icon="&#xF093;" label="OUTPUT"/>
        <section_button icon="&#xF013;" label="SYSTEM"/>
        <section_button icon="&#xF0F3;" label="TUNER"/>
      </lv_obj>

      <!-- Slot, Rig-Name, Amp und Cab -->
      <lv_label text="Slot 3"
                style_pad_left="12"
                style_text_color="#accent"
                style_text_font="lv_font_montserrat_16"/>
      <lv_label text="65 Deluxe 2.0 LQD N" width="100%" height="56" long_mode="dots"
                style_pad_left="12"
                style_text_color="#text"
                style_text_font="lv_font_montserrat_48"/>
      <lv_label text="Amp: Deluxe Reverb   /   Cab: 1x12 Jensen"
                style_pad_left="12"
                style_text_color="#text2"
                style_text_font="lv_font_montserrat_16"/>

      <lv_obj width="100%" height="1" flex_grow="1" scrollable="false" style_bg_opa="0" style_border_width="0"/>

      <!-- Effektkette -->
      <lv_obj width="100%" height="content" scrollable="false"
              flex_flow="row"
              style_bg_opa="0" style_border_width="0" style_pad_all="0"
              style_pad_column="#gap">
        <edit_tile slot="A"     name="Compressor"     color="#c_comp"  state="ON"  pill_bg="#c_comp"  pill_text="#bg" slot_color="#c_comp"  name_color="#text"/>
        <edit_tile slot="B"     name="Wah Wah"        state="OFF"/>
        <edit_tile slot="C"     name="Green Scream"   color="#c_dist"  state="ON"  pill_bg="#c_dist"  pill_text="#bg" slot_color="#c_dist"  name_color="#text"/>
        <edit_tile slot="D"     name="Studio EQ"      state="OFF"/>
        <edit_tile slot="STACK" name="Deluxe Reverb"  color="#c_stack" state="ON"  pill_bg="#c_stack" pill_text="#bg" slot_color="#c_stack" name_color="#text"/>
        <edit_tile slot="X"     name="Pitch Shifter"  state="OFF"/>
        <edit_tile slot="MOD"   name="Vintage Chorus" color="#c_mod"   state="ON"  pill_bg="#c_mod"   pill_text="#bg" slot_color="#c_mod"   name_color="#text"/>
        <edit_tile slot="DLY"   name="Dual Delay"     color="#c_dly"   state="ON"  pill_bg="#c_dly"   pill_text="#bg" slot_color="#c_dly"   name_color="#text"/>
        <edit_tile slot="REV"   name="Natural Hall"   color="#c_rev"   state="ON"  pill_bg="#c_rev"   pill_text="#bg" slot_color="#c_rev"   name_color="#text"/>
      </lv_obj>

      <!-- Morph und Tempo -->
      <lv_obj width="100%" height="44" scrollable="false"
              flex_flow="row"
              style_flex_cross_place="center" style_flex_track_place="center"
              style_bg_opa="0" style_border_width="0" style_pad_hor="12" style_pad_ver="0"
              style_pad_column="14">
        <lv_label text="Morph"
                  style_text_color="#text3"
                  style_text_font="lv_font_montserrat_14"/>
        <lv_slider width="1" flex_grow="1" height="10" value="38"
                   style_bg_color="0x2a2d31"
                   style_bg_color:indicator="#sel_line"
                   style_bg_color:knob="#text"
                   style_pad_all:knob="6"/>
        <lv_label text="38 %"
                  style_text_color="#text2"
                  style_text_font="lv_font_montserrat_14"/>
        <lv_obj width="content" height="36" scrollable="false"
                flex_flow="row"
                style_flex_cross_place="center" style_flex_track_place="center"
                style_bg_color="#tile" style_border_color="#line" style_border_width="1"
                style_radius="8" style_pad_hor="12" style_pad_ver="0" style_pad_column="8">
          <lv_obj width="10" height="10" style_radius="5"
                  style_bg_color="#c_dist" style_border_width="0"/>
          <lv_label text="120 BPM"
                    style_text_color="#text"
                    style_text_font="lv_font_montserrat_18"/>
        </lv_obj>
      </lv_obj>

      <!-- Abstand zwischen Stomps/Morph und Footswitch-Feldern -->
      <lv_obj width="100%" height="10" scrollable="false" style_bg_opa="0" style_border_width="0"/>

      <!-- Footswitch-Leiste FS1 bis FS6 -->
      <lv_obj width="100%" height="content" scrollable="false"
              flex_flow="row"
              style_bg_opa="0" style_border_width="0" style_pad_all="0"
              style_pad_column="#gap">
        <fs_button fs="FS1" label="Clean Twin"     sub="Slot 1"/>
        <fs_button fs="FS2" label="Plexi Crunch"   sub="Slot 2"/>
        <fs_button fs="FS3" label="65 Deluxe 2.0"  sub="Slot 3"
                   bg="#sel_bg" border="#sel_line"/>
        <fs_button fs="FS4" label="Lead Mars 800"  sub="Slot 4"/>
        <fs_button fs="FS5" label="Ambient Swell"  sub="Slot 5"/>
        <fs_button fs="FS6" label="Stomps"         sub="Modus"/>
      </lv_obj>
    </lv_obj>
  </view>
</screen>
